PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/cinaywave
# Generate a private random value of at least 32 characters.
JWT_SECRET=
NODE_ENV=development
# Unset: 0 locally; 1 when Render sets RENDER=true. Explicit 0 overrides auto-detection.
# Set to the known proxy hop count (0..5) if your deployment has additional proxies.
TRUST_PROXY_HOPS=

# SMTP: STARTTLS on 587, or SMTP_SECURE=true on 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CinayWave <no-reply@example.com>
# Web OAuth client ID; use the same value for Android GOOGLE_WEB_CLIENT_ID.
GOOGLE_WEB_CLIENT_ID=

# Persistent avatar storage (Cloudinary). Never put API secret in Android.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CineWave AI: keys stay on the server. No chat persistence.
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_RATE_LIMIT_PER_MINUTE=8
# Provider defaults to openai when unset; OpenAI example model: gpt-4.1-mini.
# Rate limit must be an integer from 1 to 120 requests/minute/IP.
# Model must support Structured Outputs. Maximum 2 calls/request; 35s total timeout.
